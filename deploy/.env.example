# Cam Am Tieu Dao configuration. Copy to .env and edit. NEVER commit .env.
#
#   cp .env.example .env
#
# install.sh generates AUTH_SECRET if you leave it blank, and will not overwrite anything
# you have already set.

# =============================================================================
# 1. What to bundle
# =============================================================================
# EMPTY is the normal case: this host already runs a reverse proxy (vm0/vm1 do), so the app
# publishes on loopback and nginx forwards to it.
#
#   tls   also run Caddy on :80/:443 with automatic Let's Encrypt, for a bare host
COMPOSE_PROFILES=

# =============================================================================
# 2. Where it listens
# =============================================================================
# The container serves the UI and the API on this one port. With a reverse proxy in front it
# must stay on loopback. 4249 continues the workspace's allocation (4245 landing, 4246 demo,
# 4247 license, 4248 telemetry).
BIND_ADDR=127.0.0.1
HTTP_PORT=4249

# Only read when COMPOSE_PROFILES contains `tls`.
APP_HOST=camamtieudao.com
ACME_EMAIL=

# =============================================================================
# 3. Sign-in (Google only)
# =============================================================================
# The public origin, scheme included, no trailing slash. This is what the OAuth callback is
# built from, so a mismatch with the Google console's "Authorized redirect URI" is the single
# most common cause of a redirect_uri_mismatch error. The callback is:
#     ${AUTH_URL}/api/auth/callback/google
AUTH_URL=https://camamtieudao.com

# Generated by install.sh when left blank. Changing it signs everyone out.
AUTH_SECRET=

# From the Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (application type: Web application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist of the Google accounts permitted to sign in. Leave EMPTY to allow
# any Google account - which on a public hostname means the whole internet, and every sign-in
# spends model credits. Set it unless the deployment is deliberately open.
AUTH_ALLOWED_EMAILS=

# =============================================================================
# 4. The model that reads the sheet
# =============================================================================
# There is deliberately no settings page. This is the only place the model is configured;
# changing it means editing this file and re-running install.sh.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-pro
LLM_API_KEY=
# Optional: an OpenAI-compatible gateway. Leave blank to use the provider's own endpoint.
LLM_BASE_URL=
