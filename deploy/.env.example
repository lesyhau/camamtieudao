# Cam Am Tieu Dao configuration. Copy to .env and edit. NEVER commit .env.
#
#   cp .env.example .env
#
# install.sh generates AUTH_SECRET if you leave it blank, and will not overwrite anything
# you have already set.

# =============================================================================
# 1. What to bundle
# =============================================================================
# EMPTY is the normal case: this host already runs a reverse proxy (vm0/vm1 do), so the app
# publishes on loopback and nginx forwards to it.
#
#   tls   also run Caddy on :80/:443 with automatic Let's Encrypt, for a bare host
COMPOSE_PROFILES=

# =============================================================================
# 2. Where it listens
# =============================================================================
# The container serves the UI and the API on this one port. With a reverse proxy in front it
# must stay on loopback. 4249 continues the workspace's allocation (4245 landing, 4246 demo,
# 4247 license, 4248 telemetry).
BIND_ADDR=127.0.0.1
HTTP_PORT=4249

# Only read when COMPOSE_PROFILES contains `tls`.
APP_HOST=camamtieudao.com
ACME_EMAIL=

# =============================================================================
# 3. Zalo Official Account - the first release's front end
# =============================================================================
# From the Zalo developer console. The webhook URL to register there is:
#     https://${APP_HOST}/api/webhook/zalo
ZALO_APP_ID=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=

# Which formula Zalo signs webhooks with. The official docs are client-rendered and could not
# be read, and two secondary sources disagree:
#     a  sha256(body + timestamp + secret)
#     b  sha256(app_id + body + timestamp + secret)
# `either` accepts both - safe, since both need the secret - until a real event settles it.
# Set ZALO_LOG_RAW_EVENTS=1, send one image, read the log line, then pin this to a or b.
ZALO_SIGNATURE_MODE=either
ZALO_LOG_RAW_EVENTS=0

# =============================================================================
# 4. Conversion
# =============================================================================
# free = the local OMR pipeline: no network, no per-image cost, ~13s a sheet, and on a clean
#        sheet it beats the model on notes, octave and rhythm.
# paid = a vision model. NOT more accurate on a clean sheet; what it buys is robustness to
#        photographs and the repeat/volta structure the local pipeline cannot see.
DEFAULT_TIER=free
# Conversion is CPU-bound. Two at a time on 2 vCPU leaves the event loop room to keep acking.
OMR_CONCURRENCY=2
OMR_MAX_PENDING=32

# =============================================================================
# 5. Sign-in (Google) - only for the web UI, unused by the Zalo release
# =============================================================================
# The public origin, scheme included, no trailing slash. This is what the OAuth callback is
# built from, so a mismatch with the Google console's "Authorized redirect URI" is the single
# most common cause of a redirect_uri_mismatch error. The callback is:
#     ${AUTH_URL}/api/auth/callback/google
# EMPTY disables the web UI entirely, which is the Zalo release's default. Setting it
# switches the web front end on and makes AUTH_GOOGLE_ID/SECRET required.
AUTH_URL=

# Generated by install.sh when left blank. Changing it signs everyone out.
AUTH_SECRET=

# From the Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (application type: Web application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist of the Google accounts permitted to sign in. Leave EMPTY to allow
# any Google account - which on a public hostname means the whole internet, and every sign-in
# spends model credits. Set it unless the deployment is deliberately open.
AUTH_ALLOWED_EMAILS=

# =============================================================================
# 6. The model that reads the sheet - paid tier only
# =============================================================================
# There is deliberately no settings page. This is the only place the model is configured;
# changing it means editing this file and re-running install.sh.
LLM_PROVIDER=google
# gemini-2.5-pro is NOT available on every project; check before setting it.
LLM_MODEL=gemini-3.1-pro-preview
LLM_API_KEY=
# Optional: an OpenAI-compatible gateway. Leave blank to use the provider's own endpoint.
LLM_BASE_URL=
